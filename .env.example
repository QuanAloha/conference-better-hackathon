# Copy this file to .env for local overrides. Defaults are for local development only.
POSTGRES_DB=conference
POSTGRES_USER=conference
POSTGRES_PASSWORD=conference_dev_password

FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
WHISPERLIVE_PORT=9090
LIBRETRANSLATE_PORT=5001
ELASTICSEARCH_PORT=9200

# Optional AI features. Keep real keys in .env; never commit them.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
ENHANCED_WHISPER_MODEL=small
MAX_MEDIA_BYTES=1073741824

# Optional Dash0 OTLP export. Use the endpoint, headers, and dataset from your Dash0 account.
# Example header names vary by region/account. Do not commit a populated auth header.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
